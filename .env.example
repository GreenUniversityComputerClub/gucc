# GUCC — the one environment file.
#
#   cp .env.example .env.local        (git-ignored; never commit real values)
#
# .env.local is read by the website (`bun run dev`), the local API Worker
# (`bun run dev:api`, which only takes the secrets listed in wrangler.jsonc) and
# the platform scripts. The values below work for local development as they are.
#
# Production values do NOT go here: the API Worker's secrets live in Cloudflare
# (`bunx wrangler secret put <NAME> --env production`) and the website's in
# Vercel → Project → Settings → Environment Variables. See docs/platform/DEPLOYMENT.md.

# ── Website (Next.js) ────────────────────────────────────────────────────────
# Public site origin (canonical URLs, sitemap, emailed links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# The API Worker (all backend logic). Browsers upload straight to it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Where /media/* is served from: the API Worker.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8787
# Cloudflare Turnstile site key (public). Leave empty locally; the always-pass
# test key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Shared by the website and the API Worker ────────────────────────────────
# Server-only. The website sends it on every API call. Any long random string.
API_SHARED_SECRET=dev-only-shared-secret-3b9c1f7e2a4d6b8c0e1f3a5c

# ── API Worker secrets (local) ──────────────────────────────────────────────
# Signs upload tokens and private media links; salts IP hashes.
AUTH_SECRET=dev-only-change-me-7f3c1a9e5b2d4f6a8c0e1b3d5f7a9c1e
# Mixed into every password hash and never stored in the database. Changing it
# invalidates every password, so set it once per environment and keep it.
PASSWORD_PEPPER=dev-only-pepper-5e2a9c7b1d3f4e6a8b0c2d4e
# Bot protection. Empty locally: verification is skipped.
TURNSTILE_SECRET_KEY=
# Email through SMTP2GO (API key with "Emails" send permission). Empty locally:
# messages (verification, invitations, resets) are printed in the API Worker's
# terminal instead of being sent. The sender, EMAIL_FROM="GUCC <gucc@green.edu.bd>",
# is a plain variable in wrangler.jsonc (a verified SMTP2GO single sender).
SMTP2GO_API_KEY=
CONTACT_EMAIL=
# Site assistant (optional). Models tried in order: GEMINI_MODEL (if set), gemini-3.8-flash, gemini-3.7-flash.
GOOGLE_API_KEY=

# ── Cloudflare (platform scripts: migrations, import, production setup) ─────
CLOUDFLARE_ACCOUNT_ID=c1b05716895cd372f5520dde62e5f68b
# Leave empty to use the browser login from `bunx wrangler login`. Or paste a
# token with D1, Workers R2 Storage and Workers Scripts *Edit* permissions.
CLOUDFLARE_API_TOKEN=

# ── Production (written by `bun run production:setup -- --apply`) ──────────
# The production Worker's API_SHARED_SECRET, kept here so it can be copied into
# Vercel as API_SHARED_SECRET. The Worker only stores it write-only.
PRODUCTION_API_SHARED_SECRET=

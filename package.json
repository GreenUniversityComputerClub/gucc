{
  "name": "gucc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/optimize-images.mjs && next build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:check": "node scripts/optimize-images.mjs --dry-run",
    "start": "next start",
    "lint": "next lint --dir app --dir components --dir lib --dir workers --dir scripts --dir tests",
    "fmt": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc -p workers/api --noEmit",
    "test": "vitest run",
    "test:e2e": "bun scripts/platform/e2e-prepare.ts && playwright test",
    "deploy:vercel": "bunx vercel build --prod && bunx vercel deploy --prod --prebuilt",
    "db:seed:render": "bun scripts/platform/render-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "migrate:legacy": "bun scripts/platform/migrate.ts",
    "migrate:media": "bun scripts/platform/media.ts",
    "migrate:verify": "bun scripts/platform/verify.ts",
    "bootstrap:moderator": "bun scripts/platform/bootstrap-moderator.ts",
    "dev:api": "wrangler dev --port 8787",
    "deploy:api:staging": "wrangler deploy --env staging",
    "deploy:api:production": "wrangler deploy --env production",
    "release:api:staging": "bun scripts/platform/release.ts --target staging",
    "release:api:production": "bun scripts/platform/release.ts --target production --confirm-production",
    "check:worker-size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "production:setup": "bun scripts/platform/production.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/oxide": "^4.1.10",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.177.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.523.0",
    "marked": "^18.0.14",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-confetti": "^6.4.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260925.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^24.0.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "aws4fetch": "^1.0.20",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.28",
    "prettier": "^3.6.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2",
    "wrangler": "4.140.0"
  },
  "overrides": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4"
  },
  "description": "Green University Computer Club website: Next.js frontend (Vercel) + Cloudflare Worker API with D1 and R2.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/green-university-computer-club/gucc.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/green-university-computer-club/gucc/issues"
  },
  "homepage": "https://github.com/green-university-computer-club/gucc#readme",
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
